@proto = http
@host = localhost
@port = 3000
@baseApi = /api/user
@baseUrl = {{proto}}://{{host}}:{{port}}{{baseApi}}

GET {{baseUrl}}/ HTTP/1.1

###

POST {{baseUrl}}/create
content-type: application/json

{
    "name": "first_user"
}

###

POST {{baseUrl}}/update
content-type: application/json

{
    "id": 1,
    "name": "default_user",
    "email": "default_user@example.com",
    "password": "123456"
}

###

POST {{baseUrl}}/delete
content-type: application/json

{
    "id": 2
}
