@proto = http
@host = localhost
@port = 3000
@baseApi = /api/user
@baseUrl = {{proto}}://{{host}}:{{port}}{{baseApi}}

GET {{baseUrl}}/ HTTP/1.1

###

POST {{baseUrl}}/
content-type: application/json

{
    "name": "first_user"
}

###

PUT {{baseUrl}}/1
content-type: application/json

{
    "name": "default_user",
    "email": "default_user@example.com",
    "password": "123456"
}

###

DELETE {{baseUrl}}/2
content-type: application/json
