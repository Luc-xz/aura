# Tests DROP/TRUNCATE aura_test tables and FLUSHDB Redis. Use dedicated services ONLY.
# Copy to .env.test.local (git-ignored), then fill in the isolated service passwords.
TEST_ALLOW_RESET=aura_test
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=13306
TEST_DB_USER=aura_test
TEST_DB_PASSWORD=replace-with-test-only-password
TEST_REDIS_HOST=127.0.0.1
TEST_REDIS_PORT=16379
TEST_REDIS_PASSWORD=replace-with-test-only-password
