{
  // 使用 IntelliSense 了解相关属性。 
  // 悬停以查看现有属性的描述。
  // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "启动程序",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "program": "index.js",
      "cwd": "${workspaceFolder}/server", // 新增
      "env": {
        "NODE_ENV": "production"
      },
    },
    {
      "type": "node",
      "request": "launch",
      "name": "开发模式 (nodemon)",
      "runtimeExecutable": "nodemon",
      "program": "index.js",
      "restart": true,
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "cwd": "${workspaceFolder}/server",
      "env": {
        "NODE_ENV": "development"
      },
      "sourceMaps": true
    }
  ]
}